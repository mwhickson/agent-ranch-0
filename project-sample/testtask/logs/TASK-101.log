import unittest
from testtask.src.game_logic import generate_target_number, compare_guess
import random

class TestGameLogic(unittest.TestCase):

    def test_generate_target_number_range(self):
        # Test that the generated number is within the expected range [1, 100]
        for _ in range(100): # Run multiple times to increase confidence
            target = generate_target_number()
            self.assertTrue(1 <= target <= 100, f"Target number {target} is out of range [1, 100]")

    def test_compare_guess_too_low(self):
        target = 50
        guess = 49
        expected = "Too low! Try again."
        self.assertEqual(compare_guess(target, guess), expected)

    def test_compare_guess_too_high(self):
        target = 50
        guess = 51
        expected = "Too high! Try again."
        self.assertEqual(compare_guess(target, guess), expected)

    def test_compare_guess_correct(self):
        target = 75
        guess = 75
        expected = "Congratulations! You guessed the number correctly."
        self.assertEqual(compare_guess(target, guess), expected)

if __name__ == '__main__':
    unittest.main()
