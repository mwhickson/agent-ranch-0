import unittest
from unittest.mock import patch
from testtask.src.game_logic import generate_target_number, compare_guess

class TestGameLogic(unittest.TestCase):

    @patch('testtask.src.game_logic.random.randint')
    def test_generate_target_number(self, mock_randint):
        # Set the mock to return a specific value
        mock_randint.return_value = 42
        # Call the function
        result = generate_target_number()
        # Assert the result is the mocked value
        self.assertEqual(result, 42)
        # Assert randint was called with the correct range
        mock_randint.assert_called_once_with(1, 100)

    def test_compare_guess_too_low(self):
        target = 50
        guess = 49
        expected = "Too low! Try again."
        self.assertEqual(compare_guess(target, guess), expected)

    def test_compare_guess_too_high(self):
        target = 50
        guess = 51
        expected = "Too high! Try again."
        self.assertEqual(compare_guess(target, guess), expected)

    def test_compare_guess_correct(self):
        target = 50
        guess = 50
        expected = "Congratulations! You guessed the number correctly."
        self.assertEqual(compare_guess(target, guess), expected)

if __name__ == '__main__':
    unittest.main()
