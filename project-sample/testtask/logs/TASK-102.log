import unittest
from testtask.src.game_logic import compare_guess, generate_target_number
import random

class TestGameLogic(unittest.TestCase):

    def test_compare_guess_too_low(self):
        # Test case where guess is less than target
        target = 50
        guess = 49
        expected = "Too low! Try again."
        self.assertEqual(compare_guess(target, guess), expected)

    def test_compare_guess_too_high(self):
        # Test case where guess is greater than target
        target = 50
        guess = 51
        expected = "Too high! Try again."
        self.assertEqual(compare_guess(target, guess), expected)

    def test_compare_guess_correct(self):
        # Test case where guess equals target
        target = 75
        guess = 75
        expected = "Congratulations! You guessed the number correctly."
        self.assertEqual(compare_guess(target, guess), expected)

    def test_generate_target_number_range(self):
        # Test that the generated number is within the expected range [1, 100]
        # We run it multiple times to increase confidence, though mocking is better for strict unit tests.
        for _ in range(100): 
            target = generate_target_number()
            self.assertIsInstance(target, int)
            self.assertTrue(1 <= target <= 100)

if __name__ == '__main__':
    unittest.main()
