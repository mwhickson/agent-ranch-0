from testtask.src.game_logic import compare_guess, generate_target_number
import random

class TestGameLogic(unittest.TestCase):

    def test_compare_guess_correct(self):
        # Test when guess equals target
        self.assertEqual(compare_guess(10, 10), "Congratulations! You guessed the number correctly.")

    def test_compare_guess_too_low(self):
        # Test when guess is less than target
        self.assertEqual(compare_guess(20, 15), "Too low! Try again.")

    def test_compare_guess_too_high(self):
        # Test when guess is greater than target
        self.assertEqual(compare_guess(30, 35), "Too high! Try again.")

    def test_generate_target_number_range(self):
        # Test that generate_target_number returns a value within [1, 100]
        # We run it multiple times to ensure randomness is within bounds
        for _ in range(100): 
            target = generate_target_number()
            self.assertTrue(1 <= target <= 100, f"Target number {target} is out of range [1, 100]")

if __name__ == '__main__':
    unittest.main()
