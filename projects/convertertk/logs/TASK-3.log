import unittest
from unittest.mock import MagicMock, patch
import tkinter as tk
from src.app import ConverterApp

class TestConverterGUI(unittest.TestCase):
    def setUp(self):
        """Set up the GUI environment for testing."""
        self.root = tk.Tk()
        # We use a small window size, but it won't be rendered in headless environments
        self.root.geometry("400x300")
        self.app = ConverterApp(self.root)

    def tearDown(self):
        """Clean up the GUI environment."""
        self.root.destroy()

    def test_initial_state(self):
        """Verify the initial state of the GUI components."""
        self.assertEqual(self.app.root.title(), "Tk Converter")
        self.assertEqual(self.app.result_label.cget("text"), "---")
        # Check if combobox has values
        values = self.app.combo['values']
        self.assertIn("Meters to Feet", values)
        self.assertIn("Pounds to Kilograms", values)

    def test_successful_conversion_workflow(self):
        """Simulate a full successful conversion workflow: select, input, click."""
        # 1. Select 'Celsius to Fahrenheit' (index 4 in CONVERSION_MAP values)
        # The combo values are [val[0] for val in CONVERSION_MAP.values()]
        self.app.combo.set("Celsius to Fahrenheit")
        
        # 2. Enter '100' in the entry
        self.app.input_entry.delete(0, tk.END)
        self.app.input_entry.insert(0, "100")
        
        # 3. Click the convert button
        self.app.convert_button.invoke()
        
        # 4. Verify result (100C -> 212F)
        self.assertEqual(self.app.result_label.cget("text"), "212.0000")

    def test_conversion_with_decimal(self):
        """Verify conversion with decimal input."""
        self.app.combo.set("Meters to Feet")
        self.app.input_entry.delete(0, tk.END)
        self.app.input_entry.insert(0, "1.5")
        self.app.convert_button.invoke()
        
        # 1.5 * 3.280839895 = 4.9212598425
        self.assertEqual(self.app.result_label.cget("text"), "4.9213")

    @patch('src.app.messagebox.showerror')
    def test_invalid_input_error(self, mock_showerror):
        """Verify that an error message is shown for non-numeric input."""
        self.app.combo.set("Meters to Feet")
        self.app.input_entry.delete(0, tk.END)
        self.app.input_entry.insert(0, "abc")
        
        self.app.convert_button.invoke()
        
        # Check if error box was called
        mock_showerror.assert_called_once()
        self.assertIn("could not convert string to float", mock_showerror.call_args[0][1].lower())

    @patch('src.app.messagebox.showerror')
    def test_empty_input_error(self, mock_showerror):
        """Verify that an error message is shown for empty input."""
        self.app.combo.set("Meters to Feet")
        self.app.input_entry.delete(0, tk.END)
        # Leave empty
        
        self.app.convert_button.invoke()
        
        mock_showerror.assert_called_once()
        self.assertEqual(mock_showerror.call_args[0][0], "Error")
        self.assertEqual(mock_showerror.call_args[0][1], "Please enter a value.")

    @patch('src.app.messagebox.showerror')
    def test_no_selection_error(self, mock_showerror):
        """Verify error when no conversion type is selected."""
        self.app.combo.set("")
        self.app.input_entry.delete(0, tk.END)
        self.app.input_entry.insert(0, "10")
        
        self.app.convert_button.invoke()
        
        mock_showerror.assert_called_once()
        self.assertEqual(mock_showerror.call_args[0][1], "Please select a conversion type.")

if __name__ == '__main__':
    unittest.main()
EOF

