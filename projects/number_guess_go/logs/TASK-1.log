package main

import (
	"bufio"
	"fmt"
	"math/rand"
	"os"
	"strconv"
	"time"
)

// generateRandomNumber selects a random integer between min (inclusive) and max (inclusive).
func generateRandomNumber(min, max int) int {
	// Seed the random number generator
	rand.Seed(time.Now().UnixNano())
	// Generate a random number in the range [min, max]
	return rand.Intn(max-min+1) + min
}

// playRound handles a single round of the number guessing game.
func playRound() bool {
	// 1. Generate the secret number (1 to 100)
	secretNumber := generateRandomNumber(1, 100)

	// 2. Prompt user for input
	fmt.Printf("Welcome to the Number Guessing Game! I have selected a number between 1 and 100.")
	fmt.Println("Please enter your guess:")
		reader := bufio.NewReader(os.Stdin)
		input, err := reader.ReadString('\n')
		if err != nil {
			fmt.Println("Error reading input. Exiting round.")
			return false
		}
		guessStr := input
		guess, err := strconv.Atoi(guessStr)
		if err != nil {
			fmt.Printf("Invalid input: '%s'. Please enter an integer. Round ended."
			return false
		}

	// 3. Comparison logic
	if guess < 1 || guess > 100 {
		fmt.Printf("Your guess must be between 1 and 100. Try again.")
		return false
	}

	if guess == secretNumber {
		fmt.Printf("Congratulations! You guessed the number %d correctly!\n", secretNumber)
		return true // Correct guess, continue to next round
	}

	if guess < secretNumber {
		fmt.Printf("Too low! Try again.")
		return false // Incorrect guess, end round
	}

	// If guess > secretNumber
	fmt.Printf("Too high! Try again.")
	return false // Incorrect guess, end round
}

